[Unit]
Description=Crazed TCG storefront
Documentation=file:///opt/crazed-tcg/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crazedtcg
Group=crazedtcg
WorkingDirectory=/opt/crazed-tcg
EnvironmentFile=/opt/crazed-tcg/.env
ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=5

# Logs go to the journal: journalctl -u crazed-tcg -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crazed-tcg

# Hardening. The app only ever needs to write to its data and upload dirs.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/opt/crazed-tcg/data /opt/crazed-tcg/uploads

[Install]
WantedBy=multi-user.target
