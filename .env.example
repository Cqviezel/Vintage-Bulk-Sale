# Copy this file to .env and fill it in. Never commit .env.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set to "production" on your VPS. This turns on secure cookies, which REQUIRE
# HTTPS — leave it unset when testing over plain http://localhost.
NODE_ENV=

PORT=3000
HOST=0.0.0.0

# Set to true if you run behind nginx/Caddy/Cloudflare on a non-production
# NODE_ENV. In production it is enabled automatically.
TRUST_PROXY=

# --- Telegram order notifications -------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, and copy the token it gives you.
# 2. Send your new bot any message, then open:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the "chat":{"id":...} number.
# Leave both blank to run without notifications — orders still save fine.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional: if TELEGRAM_ADMIN_CHAT_ID is a group with Topics enabled, route each
# notification kind to its own topic instead of the group's General topic. Get a
# topic's thread ID from its "Copy Link" in Telegram — it's the number after the
# chat ID, e.g. https://t.me/c/<chat>/<THIS NUMBER>. Leave either blank to have
# that notification kind fall back to General.
TELEGRAM_TOPIC_SALES=
TELEGRAM_TOPIC_OUT_OF_STOCK=

# Optional: a public chat (not the private admin chat above) to post a customer-facing
# announcement to whenever Admin -> Products -> Add by Set commits cards that went live.
# Use the chat's @username. The bot must already be a member there with permission to
# send messages, or sending will fail. Leave blank to disable.
TELEGRAM_RESTOCK_CHANNEL=
# Optional: if that chat has Topics enabled, the thread ID to post into (same "Copy
# Link" trick as the topics above). Leave blank to post to General.
TELEGRAM_RESTOCK_TOPIC=

# Optional: pick-and-choose forwarding to advertising channels. Forward any message to
# the bot in TELEGRAM_ADMIN_CHAT_ID and it replies with a "Send to ad channels?" button —
# tapping it re-forwards that message to every channel listed here. Use @usernames or
# numeric chat IDs; separate multiple targets with commas. Add ":<threadId>" after a
# target to land it in one topic instead of General (same "Copy Link" trick as
# TELEGRAM_RESTOCK_TOPIC). Leave blank to disable.
#
# Each target normally goes through the bot above, which must already be able to send
# messages there. For a channel the bot isn't (or can't be made) an admin of, prefix
# that one target with "userbot:" to route it through the userbot account configured
# below instead — that account just needs to already be a member.
# TELEGRAM_FORWARD_TARGET_CHANNELS=@channel_one,userbot:@channel_two:3
TELEGRAM_FORWARD_TARGET_CHANNELS=

# Optional: the userbot account used by any "userbot:"-prefixed forward target above.
# This logs in as a real Telegram account (not the bot) — typically a dedicated/burner
# account you've added as a member to whichever channels the shop's own bot can't post
# to. One-time setup:
#   1. Log in to https://my.telegram.org with that account, create an app under "API
#      development tools", and copy the api_id / api_hash it gives you.
#   2. Put them below, then run: npm run telegram-userbot-login
#      It'll ask for the phone number, the code Telegram texts you, and your 2FA
#      password if you have one set — then print a session string.
#   3. Paste that session string as TELEGRAM_USERBOT_SESSION and restart the app.
# Leave all three blank if you don't need the userbot fallback.
TELEGRAM_USERBOT_API_ID=
TELEGRAM_USERBOT_API_HASH=
TELEGRAM_USERBOT_SESSION=

# --- Storage ----------------------------------------------------------------
# Optional. Defaults to ./data and ./uploads next to the app. On a VPS you may
# prefer somewhere outside the deploy directory so redeploys never touch them.
# DATA_DIR=/var/lib/crazed-tcg/data
# UPLOAD_DIR=/var/lib/crazed-tcg/uploads

# --- Pokémon TCG API (optional) ---------------------------------------------
# Used by bulk import to fetch card images. Without a key you get ~1,000 lookups
# per day; a free key from https://dev.pokemontcg.io raises it to ~20,000.
POKEMON_TCG_API_KEY=
